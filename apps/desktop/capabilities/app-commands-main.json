{
  "identifier": "app-commands-main",
  "description": "Custom app commands the main window may call (every command of the app manifest)",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-control-state",
    "allow-is-human-driving",
    "allow-begin-action",
    "allow-start-bot-run",
    "allow-pause-bot-run",
    "allow-resume-bot-run",
    "allow-take-the-wheel",
    "allow-give-back-control",
    "allow-stop-bot-run",
    "allow-finish-bot-run",
    "allow-ack-stop",
    "allow-set-stop-hotkey",
    "allow-overlay-show-target",
    "allow-overlay-click",
    "allow-overlay-clear",
    "allow-simulate-bot-run",
    "allow-get-monitors-geometry",
    "allow-daemon-connect",
    "allow-daemon-restart",
    "allow-providers-cli",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-autostart-supported",
    "allow-notify-show",
    "allow-set-needs-count",
    "allow-set-tray-labels"
  ]
}
